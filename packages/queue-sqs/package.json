{
  "name": "@machize/queue-sqs",
  "version": "0.9.0",
  "description": "Amazon SQS driver for @machize/queue: native delayed delivery, app-level retries with backoff and a dead-letter queue (no priority — SQS has none).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/queue": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.0.0"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/queue-sqs"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/queue-sqs#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "queue",
    "sqs",
    "aws"
  ]
}
