{
  "name": "@machize/logger",
  "version": "0.31.0",
  "description": "Structured logger on top of Pino: automatic enrichment with requestId/tenantId via AsyncLocalStorage and redaction of sensitive fields.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/core": "workspace:*",
    "pino": "^9.6.0"
  },
  "peerDependencies": {
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/logger"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/logger#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "logging",
    "pino"
  ]
}
