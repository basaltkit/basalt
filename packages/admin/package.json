{
  "name": "@basaltkit/admin",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Headless admin kit for Basalt: derive table columns, form fields and validation from Zod schemas, plus a framework-agnostic data-source contract. The engine any React admin renders.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/admin#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "admin",
    "headless"
  ]
}
