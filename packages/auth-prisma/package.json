{
  "name": "@basaltkit/auth-prisma",
  "version": "1.1.0",
  "description": "Prisma-backed implementations of every @basaltkit/auth store (users, sessions, refresh tokens, one-time tokens, API keys, MFA) — the production reference backend (PostgreSQL/MySQL). Bring your own PrismaClient; ships a reference schema.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.prisma": "./prisma/schema.prisma"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/auth": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/auth": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/basalt.git",
    "directory": "packages/auth-prisma"
  },
  "homepage": "https://github.com/Zebedeu/basalt/tree/main/packages/auth-prisma#readme",
  "bugs": "https://github.com/Zebedeu/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "auth",
    "prisma",
    "postgresql",
    "store"
  ]
}
