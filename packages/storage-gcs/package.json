{
  "name": "@basaltkit/storage-gcs",
  "version": "1.1.2",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Google Cloud Storage driver for @basaltkit/storage \u2014 put/get/list/delete/signed URLs over @google-cloud/storage, with an injectable client for testing.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/storage": "workspace:^"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.0.0"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/storage-gcs"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/storage-gcs#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "storage",
    "gcs",
    "google-cloud"
  ]
}
