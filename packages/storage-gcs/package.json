{
  "name": "@machize/storage-gcs",
  "version": "1.0.1",
  "description": "Google Cloud Storage driver for @machize/storage — put/get/list/delete/signed URLs over @google-cloud/storage, with an injectable client for testing.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/storage": "workspace:*"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.0.0"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/storage-gcs"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/storage-gcs#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "storage",
    "gcs",
    "google-cloud"
  ]
}
