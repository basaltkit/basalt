{
  "name": "@machize/tenancy",
  "version": "0.14.0",
  "description": "Multi-tenancy for Machize: pluggable tenant resolvers (subdomain, domain, header, route), tenant context via AsyncLocalStorage and lifecycle hooks.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/core": "workspace:*"
  },
  "devDependencies": {
    "@machize/fastify": "workspace:*",
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/tenancy"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/tenancy#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "saas",
    "multi-tenant",
    "multi-tenancy"
  ]
}
