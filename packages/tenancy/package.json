{
  "name": "@basaltkit/tenancy",
  "version": "1.0.0",
  "description": "Multi-tenancy for Basalt: pluggable tenant resolvers (subdomain, domain, header, route), tenant context via AsyncLocalStorage and lifecycle hooks.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/fastify": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.2.0",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/basalt.git",
    "directory": "packages/tenancy"
  },
  "homepage": "https://github.com/Zebedeu/basalt/tree/main/packages/tenancy#readme",
  "bugs": "https://github.com/Zebedeu/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "saas",
    "multi-tenant",
    "multi-tenancy"
  ]
}
