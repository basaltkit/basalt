// Reference schema for @basaltkit/events-prisma.
//
// Copy this model into your app's schema.prisma (or run `basalt prisma:sync`),
// run `prisma migrate dev`, and pass the generated client to `prismaOutboxStore()`.
//
// Keeping the outbox in the SAME database as your business tables is what makes
// the transactional-outbox pattern work: enqueue the event in the same
// transaction as the state change, and the two can never disagree.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model OutboxEntry {
  id          String    @id
  event       String
  // JSON-serialized payload (text, null when the payload was undefined).
  payload     String?
  tenantId    String?
  createdAt   DateTime
  attempts    Int       @default(0)
  publishedAt DateTime?
  lastError   String?

  @@index([publishedAt, createdAt])
  @@map("outbox")
}
