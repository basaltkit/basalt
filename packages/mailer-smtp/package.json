{
  "name": "@basaltkit/mailer-smtp",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "SMTP driver for @basaltkit/mailer, built on nodemailer — any SMTP server, including Mailpit and MailHog in development.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/mailer": "workspace:^"
  },
  "peerDependencies": {
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^7.0.4",
    "nodemailer": "^9.0.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/mailer-smtp"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/mailer-smtp#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "mailer",
    "smtp",
    "nodemailer"
  ]
}
