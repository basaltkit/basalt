{
  "name": "@basaltkit/prisma",
  "version": "1.5.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Prisma integration for Basalt: tenant-scoping client extension (shared database), LRU client pool (database per tenant) and ctx().db.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@basaltkit/cli": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/prisma"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/prisma#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "prisma",
    "multi-tenant",
    "database"
  ]
}
