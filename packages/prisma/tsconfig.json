{
  "extends": "@basaltkit/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    // "..": the tests import the shared adapter parity driver types from
    // packages/http/tests and the tenancy sources (typecheck only — the build
    // config pins rootDir to src).
    "rootDir": "..",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "tests"]
}
