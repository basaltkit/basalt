{
  "name": "@machize/queue-rabbitmq",
  "version": "0.10.0",
  "description": "RabbitMQ driver for @machize/queue: AMQP jobs with retries, backoff, delayed delivery and priority via dead-letter queues.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/queue": "workspace:*"
  },
  "peerDependencies": {
    "amqplib": "^0.10.0"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/queue-rabbitmq"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/queue-rabbitmq#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "queue",
    "rabbitmq",
    "amqp"
  ]
}
