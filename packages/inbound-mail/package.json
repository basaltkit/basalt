{
  "name": "@basaltkit/inbound-mail",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Receive email in a Basalt app: signed raw-byte deliveries from a relay (Cloudflare Email Routing or your own MTA), bounded MIME parsing with trusted Authentication-Results/ARC, and address routing to tenant-aware handlers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "@basaltkit/http": "workspace:^",
    "@basaltkit/webhooks": "workspace:^",
    "postal-mime": "^4.0.2"
  },
  "devDependencies": {
    "@basaltkit/express": "workspace:^",
    "@basaltkit/fastify": "workspace:^",
    "@basaltkit/hono": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@hono/node-server": "^2.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.1",
    "express": "^5.0.0",
    "hono": "^4.13.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/inbound-mail"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/inbound-mail#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "email",
    "inbound-email",
    "mime",
    "cloudflare-email-routing",
    "dmarc",
    "arc",
    "multi-tenant"
  ]
}
