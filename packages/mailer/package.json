{
  "name": "@basaltkit/mailer",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Driver-agnostic Basalt mailer: typed mail definitions, previews, queueing and HTTP-API drivers (Resend, SES, Mailgun) plus log/memory. SMTP ships as @basaltkit/mailer-smtp.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/mailer"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/mailer#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "mailer",
    "email"
  ]
}
