{
  "name": "@basaltkit/mailer",
  "version": "1.0.0",
  "description": "Mail layer for Basalt: typed declarative mails with Zod, SMTP/log/memory drivers, tenant-aware sender and queue integration.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/basalt.git",
    "directory": "packages/mailer"
  },
  "homepage": "https://github.com/Zebedeu/basalt/tree/main/packages/mailer#readme",
  "bugs": "https://github.com/Zebedeu/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "mailer",
    "email"
  ]
}
