{
  "name": "@machize/webhooks",
  "version": "0.1.0",
  "description": "Outbound webhooks for Machize: signed delivery with retries and backoff, per-tenant subscriptions, and automatic dispatch from domain events.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/core": "workspace:*",
    "@machize/events": "workspace:*"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
