{
  "name": "@basaltkit/express",
  "version": "1.5.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Express adapter for Basalt: run the same typed routes, enrichers and guards on Express that you would on Fastify or Hono.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "@basaltkit/http": "workspace:^"
  },
  "peerDependencies": {
    "express": "^4.19.0 || ^5.0.0"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.0",
    "express": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/express#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "http",
    "express",
    "adapter"
  ]
}
