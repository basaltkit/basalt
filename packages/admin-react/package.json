{
  "name": "@basaltkit/admin-react",
  "version": "1.0.2",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "React binding for @basaltkit/admin: DataTable and ResourceForm rendered from Zod-derived view models, plus data-source hooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/admin": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/admin-react"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/admin-react#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "admin",
    "react"
  ]
}
