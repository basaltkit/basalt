{
  "name": "@basaltkit/exports",
  "version": "1.1.0",
  "description": "Data exports for Basalt: render typed export definitions to CSV/TSV/JSON/NDJSON (native, zero-dep) through a pluggable formatter seam, designed to run async via @basaltkit/queue.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/basalt.git",
    "directory": "packages/exports"
  },
  "homepage": "https://github.com/Zebedeu/basalt/tree/main/packages/exports#readme",
  "bugs": "https://github.com/Zebedeu/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "saas",
    "export",
    "csv",
    "reporting"
  ]
}
