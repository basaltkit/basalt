// Reference schema for @basaltkit/permissions-prisma.
// Copy these models into your app's schema.prisma, migrate, and pass the client
// to `prismaAccessStore()`.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PermUserRole {
  scope  String
  userId String
  role   String

  @@id([scope, userId, role])
  @@map("perm_user_roles")
}

model PermUserPermission {
  scope      String
  userId     String
  permission String

  @@id([scope, userId, permission])
  @@map("perm_user_permissions")
}

model PermRolePermission {
  scope      String
  role       String
  permission String

  @@id([scope, role, permission])
  @@map("perm_role_permissions")
}

// Durable TemporaryGrantStore / DelegationStore (`p.temporaryGrants`,
// `p.delegations`). Only needed when you wire them into `permissionsPlugin`.
// `expiresAt` is filtered in the query (`> now`) and re-verified by the Gate.

model PermTemporaryGrant {
  id          String   @id
  scope       String
  userId      String
  permissions String[]
  expiresAt   DateTime
  grantedBy   String?
  reason      String?

  @@index([scope, userId, expiresAt])
  @@index([expiresAt])
  @@map("perm_temporary_grants")
}

model PermDelegation {
  id          String    @id
  scope       String
  fromUserId  String
  toUserId    String
  permissions String[]
  createdAt   DateTime
  expiresAt   DateTime?

  @@index([scope, toUserId])
  @@index([scope, fromUserId])
  @@index([expiresAt])
  @@map("perm_delegations")
}
