{
  "name": "create-machize",
  "version": "1.0.1",
  "description": "Scaffold a production-shaped Machize SaaS app: npm create machize my-saas [--billing] [--ui] [--cli] [--install] [--git]",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-machize": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/create-app"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/create-app#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "saas",
    "scaffolding",
    "create",
    "starter",
    "boilerplate"
  ]
}
