{
  "name": "create-basalt",
  "version": "1.4.2",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Scaffold a production-shaped Basalt SaaS app: npm create basalt my-saas [--billing] [--ui] [--cli] [--install] [--git]",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "create-basalt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@basaltkit/auth": "workspace:^",
    "@basaltkit/cli": "workspace:^",
    "@basaltkit/config": "workspace:^",
    "@basaltkit/core": "workspace:^",
    "@basaltkit/env": "workspace:^",
    "@basaltkit/events": "workspace:^",
    "@basaltkit/fastify": "workspace:^",
    "@basaltkit/generator": "workspace:^",
    "@basaltkit/logger": "workspace:^",
    "@basaltkit/mcp": "workspace:^",
    "@basaltkit/prisma": "workspace:^",
    "@basaltkit/subscriptions": "workspace:^",
    "@basaltkit/tenancy": "workspace:^",
    "@basaltkit/testing": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/create-app"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/create-app#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "saas",
    "scaffolding",
    "create",
    "starter",
    "boilerplate"
  ]
}
