{
  "name": "@basaltkit/notifications",
  "version": "1.2.4",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Multi-channel notifications for Basalt: declarative definitions, channel drivers (in-app, mail, custom), per-recipient preferences and queue integration.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "@basaltkit/http": "workspace:^",
    "@basaltkit/mailer": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/notifications"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/notifications#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "saas",
    "notifications"
  ]
}
