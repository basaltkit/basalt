{
  "name": "@basaltkit/teams",
  "version": "1.4.2",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Teams for Basalt: multi-user tenants with roles, email invitations (accept/revoke), membership management and a teamRole route guard.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "@basaltkit/http": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@basaltkit/auth": "workspace:^",
    "@basaltkit/fastify": "workspace:^",
    "@basaltkit/subscriptions": "workspace:^",
    "@basaltkit/tenancy": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/teams"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/teams#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "saas",
    "teams",
    "invitations",
    "rbac"
  ]
}
