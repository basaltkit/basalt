// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ssh argv > darwin: the program, the safety options, -- before the destination, one remote argument 1`] = `
{
  "args": [
    "-T",
    "-o",
    "BatchMode=yes",
    "-o",
    "StrictHostKeyChecking=yes",
    "-o",
    "ConnectTimeout=10",
    "-o",
    "ServerAliveInterval=15",
    "-o",
    "ServerAliveCountMax=3",
    "-o",
    "ForwardAgent=no",
    "-o",
    "ForwardX11=no",
    "-o",
    "ClearAllForwardings=yes",
    "-o",
    "PermitLocalCommand=no",
    "-o",
    "RequestTTY=no",
    "-o",
    "LogLevel=ERROR",
    "-e",
    "none",
    "--",
    "deploy@203.0.113.10",
    "cd '/srv/myapp' && exec 'node' 'node_modules/@basaltkit/deploy/dist/bin.js' 'status' '--json=1'",
  ],
  "program": "ssh",
}
`;

exports[`ssh argv > darwin: the program, the safety options, -- before the destination, one remote argument 2`] = `
{
  "args": [
    "-T",
    "-o",
    "BatchMode=yes",
    "-o",
    "StrictHostKeyChecking=yes",
    "-o",
    "ConnectTimeout=10",
    "-o",
    "ServerAliveInterval=15",
    "-o",
    "ServerAliveCountMax=3",
    "-o",
    "ForwardAgent=no",
    "-o",
    "ForwardX11=no",
    "-o",
    "ClearAllForwardings=yes",
    "-o",
    "PermitLocalCommand=no",
    "-o",
    "RequestTTY=no",
    "-o",
    "LogLevel=ERROR",
    "-e",
    "none",
    "-p",
    "2222",
    "--",
    "myapp-prod",
    "cd '/srv/myapp' && exec '/usr/local/bin/node' 'node_modules/@basaltkit/deploy/dist/bin.js' 'run' '--json=1' '--answers=stdin' '--detach' '--unhold' '--via=ui' '--actor=alice' '--config=deploy.prod.ts'",
  ],
  "program": "/opt/ssh",
}
`;

