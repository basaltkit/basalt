{
  "name": "@basaltkit/deploy-ui",
  "version": "0.5.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "A local web UI for @basaltkit/deploy: runs on the operator's machine, listens on 127.0.0.1 only, and drives the server over the system ssh with the operator's own keys. Never an app dependency.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "basalt-deploy-ui": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/vendor-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@basaltkit/deploy": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/i18n": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/deploy-ui"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/deploy-ui#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "deploy",
    "ssh",
    "ui"
  ]
}
