{
  "name": "@basaltkit/cache-redis",
  "version": "0.0.0",
  "engines": { "node": ">=22.5.0" },
  "description": "Redis cache driver for @basaltkit/cache: a shared cache across processes, with atomic SWR and tag invalidation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@basaltkit/cache": "workspace:^" },
  "peerDependencies": { "ioredis": "^6.0.0" },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.3.0",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/cache-redis"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/cache-redis#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": ["basalt", "typescript", "cache", "redis", "ioredis"]
}
