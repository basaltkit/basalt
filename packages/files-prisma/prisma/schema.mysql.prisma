// Reference schema for @basaltkit/files-prisma — MySQL variant.
//
// Same models as schema.prisma, with native types sized for MySQL: a bare
// `String` becomes VARCHAR(191) there, and outside strict mode MySQL truncates
// a longer value silently — a cut `path` no longer names the stored object.
// Free-text columns are widened below; the keys stay VARCHAR(191) so they can
// be indexed. Pair it with `prismaFilesStore(prisma, { columnLimits: 'mysql' })`
// (and the same option on `prismaFileVersionsStore`), which refuses a value
// that would still not fit instead of letting it be cut.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model File {
  tenantId    String
  id          String
  name        String    @db.Text
  contentType String    @db.VarChar(255)
  // Bytes. Int tops out at 2 GB, which a video upload passes without trying.
  size        BigInt
  // Key within the storage disk — the only link back to the bytes. Losing this
  // row orphans them permanently, which is the reason this package exists.
  path        String    @db.Text
  checksum    String
  uploadedBy  String?
  metadata    Json?
  // Null means never scanned. A date rather than a flag: it derives the
  // boolean, and it answers "is this result still worth trusting?".
  scannedAt   DateTime?
  createdAt   DateTime

  @@id([tenantId, id])
  @@index([tenantId, createdAt])
  // Quota checks sum size per tenant on every upload.
  @@index([tenantId])
  @@map("files")
}

// For @basaltkit/files-versions. Only needed if you use that package.
model FileVersion {
  tenantId  String
  // The document. Stable across every revision; this is what your own entity
  // stores against a matter or a client.
  groupId   String
  // The File holding this revision's bytes.
  fileId    String
  version   Int
  note      String?   @db.Text
  by        String?
  createdAt DateTime

  // The unique key is the whole concurrency story: two uploads landing together
  // cannot both become version 3 — one insert wins and the other is refused,
  // rather than both succeeding and leaving two revisions with the same number.
  @@id([tenantId, groupId, version])
  @@index([tenantId, groupId, version(sort: Desc)])
  @@map("file_versions")
}
