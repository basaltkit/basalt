{
  "name": "@basaltkit/webhooks-sqlite",
  "version": "1.1.0",
  "description": "Durable, SQLite-backed implementation of the @basaltkit/webhooks WebhookStore (endpoint subscriptions), on Node's built-in node:sqlite. Zero external dependencies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/webhooks": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/webhooks": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/webhooks-sqlite"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/webhooks-sqlite#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "webhooks",
    "sqlite",
    "store"
  ]
}
