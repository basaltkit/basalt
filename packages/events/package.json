{
  "name": "@basaltkit/events",
  "version": "1.1.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Basalt event bus: domain events typed with Zod, prioritized listeners, wildcards and container integration.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/events"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/events#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "events",
    "event-bus"
  ]
}
