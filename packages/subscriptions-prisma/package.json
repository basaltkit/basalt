{
  "name": "@basaltkit/subscriptions-prisma",
  "version": "2.1.0",
  "description": "Prisma-backed implementations of the @basaltkit/subscriptions stores (subscriptions, atomic usage metering, webhook idempotency) — the production reference backend (PostgreSQL/MySQL). Bring your own PrismaClient; ships a reference schema.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.prisma": "./prisma/schema.prisma"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/subscriptions": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/subscriptions": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.2.0",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/subscriptions-prisma"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/subscriptions-prisma#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "subscriptions",
    "billing",
    "prisma",
    "postgresql",
    "store"
  ]
}
