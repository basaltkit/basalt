{
  "name": "@basaltkit/subscriptions-proxypay",
  "version": "2.1.3",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "ProxyPay payment gateway driver for @basaltkit/subscriptions \u2014 reference-based Multicaixa/EMIS payments for Angola (AOA), implementing the PaymentGateway contract.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/subscriptions": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/subscriptions": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/subscriptions-proxypay"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/subscriptions-proxypay#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "payments",
    "proxypay",
    "multicaixa",
    "emis",
    "angola",
    "subscriptions"
  ]
}
