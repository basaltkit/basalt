// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`human mode, byte for byte > env with answers at a terminal 1`] = `
[
  "exit 0",
  "STEP env",
  "WARN PAYCO_SECRET_TOKEN is required",
  "INFO add APP_SECRET (generated)",
  "INFO add PAYCO_CALLBACK_URL (derived from the domain/port)",
  "INFO add PAYCO_SECRET_TOKEN (answered)",
  "INFO add SUPPORT_EMAIL (answered)",
  "STEP infra",
  "OK nothing to start (external infra)",
  "STEP validate",
  "OK .env is valid for src/env.ts",
  "OK .env ready (PORT=3002)",
]
`;

exports[`human mode, byte for byte > env without a terminal 1`] = `
[
  "exit 1",
  "STEP env",
  "ERROR no answer for PAYCO_SECRET_TOKEN (no terminal to ask): set them in the environment of this command",
]
`;

exports[`human mode, byte for byte > plan 1`] = `
[
  "exit 0",
  "STEP preflight",
  "STEP plan — nothing below has run",
  "INFO fetch: git fetch -- origin +refs/heads/master:refs/remotes/origin/master && git merge --ff-only refs/remotes/origin/master",
  "INFO env: add APP_SECRET (generated)",
  "INFO env: add PAYCO_CALLBACK_URL (derived from the domain/port)",
  "INFO env: ask PAYCO_SECRET_TOKEN",
  "INFO env: ask SUPPORT_EMAIL",
  "INFO build: pnpm install (frozen), prisma generate --config prisma.config.ts, web build",
  "INFO validate: src/env.ts against the new .env",
  "INFO backup: skipped (backup.beforeMigrate is false)",
  "INFO migrate: prisma migrate deploy + tenant:migrate",
  "INFO release: pm2 acme-api on 127.0.0.1:3002",
  "INFO health: http://127.0.0.1:3002/health (Host: acme.example.com), then https://acme.example.com/api/health",
]
`;

exports[`human mode, byte for byte > rollback with nothing to go back to 1`] = `
[
  "exit 1",
  "ERROR no earlier release to go back to; pass --to=<sha>",
]
`;

