{
  "name": "@basaltkit/subscriptions-pdf",
  "version": "0.1.3",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Render @basaltkit/subscriptions invoices to PDF with pdfkit \u2014 a printable invoice from the same Invoice object, kept out of the dependency-free core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  },
  "peerDependencies": {
    "@basaltkit/subscriptions": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/subscriptions": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "@types/pdfkit": "^0.17.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/subscriptions-pdf"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/subscriptions-pdf#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "subscriptions",
    "billing",
    "invoice",
    "pdf",
    "pdfkit"
  ]
}
