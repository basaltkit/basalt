{
  "name": "@basaltkit/notifications-sqlite",
  "version": "1.0.0",
  "description": "Durable, SQLite-backed implementation of the @basaltkit/notifications InAppStore (in-app notifications), on Node's built-in node:sqlite. Zero external dependencies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/notifications": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/notifications": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.2.0",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/basalt.git",
    "directory": "packages/notifications-sqlite"
  },
  "homepage": "https://github.com/Zebedeu/basalt/tree/main/packages/notifications-sqlite#readme",
  "bugs": "https://github.com/Zebedeu/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "notifications",
    "sqlite",
    "store"
  ]
}
