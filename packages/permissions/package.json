{
  "name": "@basaltkit/permissions",
  "version": "1.3.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Authorization for Basalt, Spatie-style: roles, permissions with wildcards, policies, tenant scoping, super admin and route guards.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "@basaltkit/http": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/fastify": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/permissions"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/permissions#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "saas",
    "authorization",
    "rbac",
    "permissions"
  ]
}
