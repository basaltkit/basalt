{
  "name": "@machize/api-keys-ui",
  "version": "1.0.0",
  "description": "A self-contained HTML page to manage @machize/auth API keys: create (show once), list and revoke — zero dependencies, no build.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/core": "workspace:*",
    "@machize/fastify": "workspace:*"
  },
  "devDependencies": {
    "@machize/auth": "workspace:*",
    "@machize/tenancy": "workspace:*",
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/api-keys-ui"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/api-keys-ui#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "saas",
    "api-keys",
    "ui"
  ]
}
