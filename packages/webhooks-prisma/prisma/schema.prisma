// Reference schema for @machize/webhooks-prisma.
//
// Copy this model into your app's schema.prisma (or run `mach prisma:sync`),
// run `prisma migrate dev`, and pass the generated client to `prismaWebhookStore()`.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WebhookEndpoint {
  id       String   @id
  url      String
  // Event patterns this endpoint receives, as a JSON array (e.g. ["invoice.*"]).
  events   String
  tenantId String?
  secret   String?
  active   Boolean?

  @@index([tenantId])
  @@map("webhook_endpoints")
}
