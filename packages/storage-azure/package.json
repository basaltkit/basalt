{
  "name": "@basaltkit/storage-azure",
  "version": "1.0.0",
  "description": "Azure Blob Storage driver for @basaltkit/storage \u2014 put/get/list/delete/SAS URLs over @azure/storage-blob, with an injectable client for testing.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/storage": "workspace:^"
  },
  "peerDependencies": {
    "@azure/storage-blob": "^12.0.0"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.3.0",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/storage-azure"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/storage-azure#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "storage",
    "azure",
    "blob"
  ]
}
