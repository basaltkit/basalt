{
  "name": "@machize/exports-xlsx",
  "version": "1.0.4",
  "description": "XLSX formatter for @machize/exports — writes a valid single-sheet .xlsx (Office Open XML) with a built-in ZIP writer. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/exports": "workspace:*"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/exports-xlsx"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/exports-xlsx#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "export",
    "xlsx",
    "excel"
  ]
}
