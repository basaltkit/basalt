{
  "name": "@basaltkit/search-elasticsearch",
  "version": "1.1.1",
  "description": "Elasticsearch / OpenSearch driver for @basaltkit/search \u2014 multi_match relevance, tenant-scoped, talking to the REST API directly with an injectable fetch (no SDK).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/search": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.2.0",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/search-elasticsearch"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/search-elasticsearch#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "search",
    "elasticsearch",
    "opensearch",
    "full-text"
  ]
}
