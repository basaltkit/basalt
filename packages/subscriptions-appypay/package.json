{
  "name": "@basaltkit/subscriptions-appypay",
  "version": "0.3.0",
  "description": "AppyPay payment gateway driver for @basaltkit/subscriptions — Multicaixa Express (push), reference and card payments for Angola (AOA). PRE-RELEASE: pending validation against the live AppyPay API.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/subscriptions": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/subscriptions": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/subscriptions-appypay"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/subscriptions-appypay#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "payments",
    "appypay",
    "multicaixa",
    "multicaixa-express",
    "emis",
    "angola",
    "subscriptions"
  ],
  "private": true
}
