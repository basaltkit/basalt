{
  "name": "@machize/dashboard",
  "version": "0.4.0",
  "description": "Headless admin dashboard model for Machize: billing metrics (MRR/ARR/churn), queue/audit summaries and a section registry binding admin resources to the SDK.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/admin": "workspace:*",
    "@machize/subscriptions": "workspace:*"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/dashboard#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "dashboard",
    "metrics"
  ]
}
