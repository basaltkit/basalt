{
  "name": "@basaltkit/auth-sqlite",
  "version": "1.0.0",
  "description": "Durable, SQLite-backed implementations of every @basaltkit/auth store (users, sessions, refresh tokens, one-time tokens, API keys, MFA) built on Node's built-in node:sqlite. Zero external dependencies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/auth": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/auth": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.2.0",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/basalt.git",
    "directory": "packages/auth-sqlite"
  },
  "homepage": "https://github.com/Zebedeu/basalt/tree/main/packages/auth-sqlite#readme",
  "bugs": "https://github.com/Zebedeu/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "auth",
    "sqlite",
    "sessions",
    "store"
  ]
}
