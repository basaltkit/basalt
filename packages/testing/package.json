{
  "name": "@machize/testing",
  "version": "0.3.0",
  "description": "Testing kit for Machize apps: createTestApp with user/tenant impersonation, mail and queue fakes with assertions, and time travel.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@machize/core": "workspace:*",
    "@machize/fastify": "workspace:*",
    "@machize/mailer": "workspace:*",
    "@machize/queue": "workspace:*",
    "fastify": "^5.3.0"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
