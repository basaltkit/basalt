{
  "name": "@basaltkit/testing",
  "version": "1.1.3",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Testing kit for Basalt apps: createTestApp with user/tenant impersonation, mail and queue fakes with assertions, and time travel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "@basaltkit/fastify": "workspace:^",
    "@basaltkit/mailer": "workspace:^",
    "@basaltkit/queue": "workspace:^",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@basaltkit/express": "workspace:^",
    "@basaltkit/hono": "workspace:^",
    "@basaltkit/http": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^26.3.0",
    "express": "^5.0.0",
    "hono": "^4.13.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/testing#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "testing"
  ],
  "peerDependencies": {
    "@basaltkit/express": "workspace:^",
    "@basaltkit/hono": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@basaltkit/express": {
      "optional": true
    },
    "@basaltkit/hono": {
      "optional": true
    }
  }
}
