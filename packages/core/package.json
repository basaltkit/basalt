{
  "name": "@machize/core",
  "version": "0.6.0",
  "description": "Foundation of the Machize ecosystem: token-based DI container, plugin system, lifecycle, hooks and context via AsyncLocalStorage.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@machize/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/machize.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Zebedeu/machize/tree/main/packages/core#readme",
  "bugs": "https://github.com/Zebedeu/machize/issues",
  "keywords": [
    "machize",
    "typescript",
    "dependency-injection",
    "plugins",
    "backend",
    "asynclocalstorage"
  ]
}
