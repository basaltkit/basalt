{
  "name": "@basaltkit/mcp",
  "version": "3.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Model Context Protocol for Basalt: expose opt-in routes as MCP tools over HTTP (any adapter) or stdio, and consume external MCP servers as a client — all through the neutral route pipeline.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basaltkit/core": "workspace:^",
    "@basaltkit/http": "workspace:^",
    "@basaltkit/mcp-core": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@basaltkit/express": "workspace:^",
    "@basaltkit/fastify": "workspace:^",
    "@basaltkit/hono": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.5.1",
    "express": "^5.0.0",
    "fastify": "^5.12.5",
    "hono": "^4.13.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltkit/basalt.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/basaltkit/basalt/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/basaltkit/basalt/issues",
  "keywords": [
    "basalt",
    "mcp",
    "model-context-protocol",
    "ai",
    "tools",
    "agent"
  ]
}
