{
  "name": "@basaltkit/activity-prisma",
  "version": "1.0.0",
  "description": "Prisma-backed implementation of the @basaltkit/activity ActivityStore (activity feed) — the production reference backend (PostgreSQL/MySQL). Bring your own PrismaClient; ships a reference schema.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.prisma": "./prisma/schema.prisma"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@basaltkit/activity": "workspace:^"
  },
  "devDependencies": {
    "@basaltkit/activity": "workspace:^",
    "@basaltkit/tsconfig": "workspace:^",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/basalt.git",
    "directory": "packages/activity-prisma"
  },
  "homepage": "https://github.com/Zebedeu/basalt/tree/main/packages/activity-prisma#readme",
  "bugs": "https://github.com/Zebedeu/basalt/issues",
  "keywords": [
    "basalt",
    "typescript",
    "activity",
    "prisma",
    "store",
    "postgresql"
  ]
}
