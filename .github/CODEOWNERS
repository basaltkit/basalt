# Code owners for Basalt.
#
# As the project grows, assign owners per package so reviews route to the
# people who maintain each area. Until dedicated teams exist, the core team
# owns everything. Replace @basaltkit/core-team with real GitHub teams/handles.

* @basaltkit/core-team

# Foundation
/packages/core/        @basaltkit/core-team
/packages/config/      @basaltkit/core-team
/packages/env/         @basaltkit/core-team
/packages/events/      @basaltkit/core-team
/packages/logger/      @basaltkit/core-team

# Infrastructure
/packages/fastify/     @basaltkit/core-team
/packages/prisma/      @basaltkit/core-team

# SaaS domain
/packages/tenancy/       @basaltkit/core-team
/packages/auth/          @basaltkit/core-team
/packages/permissions/   @basaltkit/core-team
/packages/subscriptions/ @basaltkit/core-team

# Release + governance
/.github/              @basaltkit/core-team
/.changeset/           @basaltkit/core-team
/ARCHITECTURE.md       @basaltkit/core-team
