{
  "name": "playground",
  "private": true,
  "description": "Basalt reference app — the same neutral route() list served on fastify, express AND hono (ADAPTER=env), also exposed as MCP tools. Living E2E of the core (config, env, logger, events, tenancy, HTTP, MCP).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp:stdio": "tsx src/mcp-stdio.ts"
  },
  "dependencies": {
    "@basaltkit/config": "workspace:*",
    "@basaltkit/core": "workspace:*",
    "@basaltkit/env": "workspace:*",
    "@basaltkit/events": "workspace:*",
    "@basaltkit/express": "workspace:*",
    "@basaltkit/fastify": "workspace:*",
    "@basaltkit/hono": "workspace:*",
    "@basaltkit/http": "workspace:*",
    "@basaltkit/logger": "workspace:*",
    "@basaltkit/mcp": "workspace:*",
    "@basaltkit/tenancy": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@basaltkit/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
