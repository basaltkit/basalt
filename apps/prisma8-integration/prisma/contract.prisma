// use prisma-8

// The central plane of the harness, in `public` of its own database
// (basalt_prisma8). Tenant contracts are generated from this file at test time,
// wrapped in `namespace tenant_<id> { … }` (tests/support/tenants.ts).

// Row-level tenancy and RLS (tests/rls.test.ts, tests/middleware.test.ts): one
// shared table, every row carries its tenant. Declared first so `Project` stays the
// last model (writeTenantContract appends evolution fields to the last model).
model Note {
  id       String @id
  tenantId String
  body     String

  @@index([tenantId])
}

model Project {
  id        String            @id
  tenantId  String
  name      String
  createdAt TimestamptzString @default(now())

  @@index([tenantId])
}
