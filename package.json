{
  "name": "basalt",
  "version": "1.8.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "lint": "echo 'lint: temporarily disabled \u2014 ESLint is incompatible with the current TypeScript version (typescript-eslint does not yet support TS>=7). Re-enable: pnpm lint:eslint \u2014 see eslint.config.mjs.'",
    "lint:eslint": "eslint ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
